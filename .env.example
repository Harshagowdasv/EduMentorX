# EduMentorX Configuration Example

# Demo Mode toggle (Set to true to use IndexedDB local seed provider)
VITE_DEMO_MODE=true

# Firebase Client Configuration (Used when VITE_DEMO_MODE=false)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Server-Side Configuration (Stored in backend server environment, NOT client Vite bundle)
GEMINI_API_KEY=
PORT=5000
